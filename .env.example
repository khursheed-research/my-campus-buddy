# ---- Supabase project (database + edge functions) ----
# Found in Supabase dashboard > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL to the Supabase Edge Functions (chat + upload).
# Same as SUPABASE_URL, just used from the browser for the AI chat/upload widgets.
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# ---- AI model ----
# The GEMINI_API_KEY itself lives as a Supabase Edge Function secret
# (Supabase dashboard > Edge Functions > chat > Secrets), NOT here.
# This app never talks to Gemini directly — it always goes through
# the Supabase "chat" edge function, which holds the key server-side.
